---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="es" altHref="/en" title="404 · reiderer">
  <section class="wrap notfound">
    <div class="code mono">4<span class="r">0</span>4</div>
    <h1>Esta ruta no existe.</h1>
    <p class="lead">O nunca existió, o se movió. En cualquier caso, no hay nada que ver aquí. <span class="mono">// page not found</span></p>
    <div style="display:flex;gap:.8rem;margin-top:.6rem">
      <a class="btn btn-primary" href="/">Volver al inicio</a>
      <a class="btn btn-ghost" href="/blog">Ir al blog</a>
    </div>
  </section>
</Layout>

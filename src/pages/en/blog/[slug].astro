---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => p.data.lang === 'en');
  return posts.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const date = entry.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// If the ES version of this post exists (same translationKey), the language switch points to it.
let altHref = '/blog';
if (entry.data.translationKey) {
  const twin = await getCollection('blog', (p) => p.data.lang === 'es' && p.data.translationKey === entry.data.translationKey);
  if (twin.length > 0) altHref = `/blog/${twin[0].slug}`;
}
---
<Layout lang="en" altHref={altHref} title={`${entry.data.title} · reiderer`} description={entry.data.description}>
  <article class="wrap article">
    <a class="back" href="/en/blog">← Blog</a>
    <span class="cat">{entry.data.category}</span>
    <h1>{entry.data.title}</h1>
    <div class="date">{date}</div>
    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>
